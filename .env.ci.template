# =============================================================================
#  Codemagic 环境变量模板 —— youdake_env 组
#
#  用途：本文件只列「需要配哪些变量、变量名是什么」，不含任何真实密钥值。
#  做法：登录 Codemagic → 你的 App → Environment variables → 新建组，
#        组名填 youdake_env，勾选 Secure，逐条添加下面 4 个变量。
#        值从你本机 yunying/env_release.json 里抄，不要发给任何人（包括我）。
#
#  ⚠️ 不要把真实值填进本文件，也不要把本文件改名为 env_release.json 后提交。
# =============================================================================

# 环境标识
ENV=release

# 后端接口地址（你已确认正式版用 .com）
API_HOST=https://youdake.com/team/

# 阿里云推送 AppKey（非机密，但一并放加密组更稳妥）
PUSH_APP_KEY=<填你 env_release.json 里的 PUSH_APP_KEY>

# 🔴 阿里云推送 AppSecret —— 机密，只填在 Codemagic 加密变量里
PUSH_APP_SECRET=<填你 env_release.json 里的 PUSH_APP_SECRET，切勿外发>
