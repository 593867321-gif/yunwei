# =============================================================================
#  统一行尾为 LF
#  本 CI 包在 Windows 上编辑、在 Codemagic(macOS) 构建机上 clone 后构建。
#  强制 LF 可避免 ios/Runner.xcodeproj/project.pbxproj、ios/Podfile 等关键文件
#  因 CRLF 行尾在 macOS/Xcode/CocoaPods 上解析异常，也消除跨平台 diff 噪音。
# =============================================================================

# 所有文本文件：仓库内存 LF，checkout 也用 LF
* text=auto eol=lf

# 二进制资源：禁止任何行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary
*.p8 binary
*.mobileprovision binary
*.zip binary
*.pdf binary
